# Aster Market environment contract
# Copy this file to .env.local for local development.
# Keep real values only in ignored local files or Vercel Sensitive Environment
# Variables. Next.js loads .env.local automatically. A standalone Node script
# must load it explicitly (for example: node --env-file=.env.local script.mjs).

# Application
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL
# Pooled application URL and direct migration/admin URL from the same branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
# Branch-specific URL supplied by Neon; includes the auth path.
NEON_AUTH_BASE_URL=
# App-managed cached-session cookie secret (not supplied by Neon Auth).
# Generate 32 random bytes (256 bits) per environment, for example with
# openssl rand -base64 32. Local setup: node scripts/configure-local-neon.mjs
NEON_AUTH_COOKIE_SECRET=

# Optional Neon Data API
# Provider URL only. P0 queries PostgreSQL from server code and does not call
# the Data API. Do not expose direct database access to the browser by default.
NEON_DATA_API_URL=

# Optional Neon Object Storage (NOT an AWS S3 bucket or AWS account)
# Neon supplies these conventional AWS_* names for its S3-compatible protocol.
# Use only the Neon branch endpoint and Neon-issued keys; never default the SDK
# to AWS S3. Create a bucket on that branch before use. Keep keys server-side
# and configure path-style addressing in the S3 client.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket names are not secrets. Keep public catalog/media reads separate from
# private operational uploads and generated/source files.
NEON_PUBLIC_ASSETS_BUCKET=catalog-assets
NEON_PRIVATE_UPLOADS_BUCKET=private-uploads

# Checkout is server-side and simulated; no payment provider or payment keys.

# Application email (order messages, not Neon Auth verification/recovery).
# Neon Auth sends its own auth emails. Keep app-owned email captured until a
# concrete order-message slice chooses a sender provider.
#
# Allowed values: capture.
EMAIL_MODE=capture
EMAIL_FROM="Aster Market <no-reply@aster-market.local>"

# If a future active slice introduces protected scheduled work, generate a
# separate 256-bit CRON_SECRET then; P0 checkout requires no scheduler.

# Logging
# Allowed values: debug | info | warn | error. Logs must remain redacted.
LOG_LEVEL=debug
