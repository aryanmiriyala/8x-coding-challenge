# Aster Market environment contract
# Copy this file to .env.local for local development.
# Keep real values only in ignored local files or Vercel Sensitive Environment
# Variables. Next.js loads .env.local automatically. A standalone Node script
# must load it explicitly (for example: node --env-file=.env.local script.mjs).

# Application
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL
# Pooled application URL and direct migration/admin URL from the same branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
# Branch-specific URL supplied by Neon; includes the auth path.
NEON_AUTH_BASE_URL=
# Next.js cached-session cookie secret. Generate a distinct 32+ character
# value per environment with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Optional Neon Data API
# Provider URL only. P0 queries PostgreSQL from server code and does not call
# the Data API. Do not expose direct database access to the browser by default.
NEON_DATA_API_URL=

# Optional Neon Object Storage
# Fill only after a bucket exists on the same Neon branch. Keep credentials on
# the server. A client must use path-style S3 addressing.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Payments
# Allowed values: fake | stripe_test. No live-payment mode exists.
PAYMENT_MODE=fake

# Required only when PAYMENT_MODE=stripe_test. Test/restricted-test keys only;
# application validation must reject live-key prefixes and live-mode events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Application email (order messages, not Neon Auth verification/recovery).
# Neon Auth sends its own auth emails. Allowed values: capture | resend.
EMAIL_MODE=capture
EMAIL_FROM="Aster Market <no-reply@aster-market.local>"

# Required only when EMAIL_MODE=resend. Use a sending-only key restricted to
# the verified demo domain when supported.
RESEND_API_KEY=

# Scheduled reservation cleanup
# Required only when the protected cleanup route is enabled. Generate a unique
# high-entropy value per deployed environment.
CRON_SECRET=

# Logging
# Allowed values: debug | info | warn | error. Logs must remain redacted.
LOG_LEVEL=debug
