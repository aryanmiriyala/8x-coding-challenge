# Aster Market environment contract
# Copy this file to .env.local for local development.
# Never commit populated secrets. Deployed values belong in Vercel Sensitive
# Environment Variables or an approved native integration.

# Application URLs
APP_BASE_URL=http://localhost:3000

# PostgreSQL
# Use the pooled URL for normal application traffic and the direct URL for
# migrations, dumps, and session-level administration. The local examples may
# point to the same server; Neon values must point to the same isolated branch.
DATABASE_URL=postgresql://aster:aster_dev@localhost:5432/aster_market?schema=public
DATABASE_URL_UNPOOLED=postgresql://aster:aster_dev@localhost:5432/aster_market?schema=public

# Neon Auth (Managed Better Auth)
# Branch-specific URL supplied by Neon. It includes the auth path; do not
# substitute APP_BASE_URL. Localhost origins are normally allowed by Neon.
NEON_AUTH_BASE_URL=

# Next.js session-cookie cache secret. Neon does not inject it. Generate a
# distinct 32+ character value per environment: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Payments
# Allowed values: fake | stripe_test. No live-payment mode exists.
PAYMENT_MODE=fake

# Required only when PAYMENT_MODE=stripe_test. Test/restricted-test keys only;
# application validation must reject live-key prefixes and live-mode events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Application email (order messages, not Neon Auth verification/recovery).
# Neon Auth sends its own auth emails. Allowed values: capture | resend.
EMAIL_MODE=capture
EMAIL_FROM=Aster Market <no-reply@aster-market.local>

# Required only when EMAIL_MODE=resend. Use a sending-only key restricted to
# the verified demo domain when supported.
RESEND_API_KEY=

# Scheduled reservation cleanup
# Required only when the protected cleanup route is enabled. Generate a unique
# high-entropy value per deployed environment.
CRON_SECRET=

# Logging
# Allowed values: debug | info | warn | error. Logs must remain redacted.
LOG_LEVEL=debug
