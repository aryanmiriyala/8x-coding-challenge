generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Status {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum Condition {
  NEW
}

enum FulfillmentType {
  PLATFORM
}

model Seller {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  display_name String
  status       Status   @default(ACTIVE)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  offers Offer[]

  @@map("seller")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parent_id   String?  @db.Uuid
  slug        String   @unique
  name        String
  description String?
  sort_order  Int      @default(0)
  status      Status   @default(ACTIVE)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  parent   Category?         @relation("CategoryToCategory", fields: [parent_id], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryToCategory")
  products ProductCategory[]

  @@index([parent_id, sort_order])
  @@index([status])
  @@map("category")
}

model Product {
  id                        String   @id @default(uuid()) @db.Uuid
  slug                      String   @unique
  title                     String
  brand                     String
  description               String
  bullet_points             Json // Array of strings
  status                    Status   @default(DRAFT)
  rating_average_hundredths Int      @default(0) // 0..500
  rating_count              Int      @default(0)
  search_text               String // Normalized text for search
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt @db.Timestamptz(6)

  categories ProductCategory[]
  variants   ProductVariant[]
  images     ProductImage[]

  @@index([status, created_at])
  // Note: GIN and pg_trgm indexes require raw SQL migrations
  @@map("product")
}

model ProductCategory {
  product_id  String @db.Uuid
  category_id String @db.Uuid

  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@map("product_category")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  product_id String  @db.Uuid
  variant_id String? @db.Uuid
  url        String // Static asset path for P0
  alt_text   String
  sort_order Int     @default(0)
  width      Int?
  height     Int?

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@map("product_image")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  sku        String   @unique
  title      String
  attributes Json // e.g. { "color": "Black", "size": "M" }
  status     Status   @default(ACTIVE)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  product Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  offers  Offer[]
  images  ProductImage[]

  @@index([product_id])
  @@map("product_variant")
}

model Offer {
  id               String          @id @default(uuid()) @db.Uuid
  variant_id       String          @db.Uuid
  seller_id        String          @db.Uuid
  condition        Condition       @default(NEW)
  fulfillment_type FulfillmentType @default(PLATFORM)
  price_minor      Int // Non-negative integer
  compare_at_minor Int? // >= price_minor if present
  currency         String          @default("USD") @db.Char(3)
  status           Status          @default(ACTIVE)
  order_limit      Int? // Optional bounded per-order limit
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  seller    Seller         @relation(fields: [seller_id], references: [id], onDelete: Restrict)
  inventory Inventory?
  cartItems CartItem[]

  @@index([variant_id])
  @@index([seller_id])
  @@map("offer")
}

model Inventory {
  offer_id   String   @id @db.Uuid
  available  Int      @default(0) // non-negative
  version    Int      @default(0) // non-negative
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  offer Offer @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@map("inventory")
}

enum CartStatus {
  OPEN
  MERGED
  CHECKED_OUT
  EXPIRED
}

model CustomerProfile {
  auth_user_id String   @id
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  @@map("customer_profile")
}

model Cart {
  id               String     @id @default(uuid()) @db.Uuid
  user_id          String? // FK to customer_profile or opaque string
  guest_token_hash String?    @unique
  status           CartStatus @default(OPEN)
  currency         String     @default("USD") @db.Char(3)
  version          Int        @default(0)
  expires_at       DateTime?  @db.Timestamptz(6)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @updatedAt @db.Timestamptz(6)

  items CartItem[]

  @@index([user_id])
  @@index([guest_token_hash])
  @@map("cart")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cart_id    String   @db.Uuid
  offer_id   String   @db.Uuid
  quantity   Int // positive integer
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  cart  Cart  @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offer_id], references: [id], onDelete: Restrict)

  @@unique([cart_id, offer_id])
  @@map("cart_item")
}
